# Template for the production environment file.
#
#   cp .env.prod.example .env.prod
#
# Then fill it in. .env.prod is gitignored — keep it that way, and prefer your
# platform's secret store over a file on disk where you have one.
#
# Used as:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# Tag applied to the built image, e.g. a release number or git SHA.
APP_VERSION=latest

# Published on 127.0.0.1 only — put a TLS-terminating reverse proxy in front.
APP_PORT=8080

# MUST be unique to this deployment. Generate one with:
#   docker run --rm cms-template-engine:latest php artisan key:generate --show
# Changing it later invalidates all sessions and any encrypted data.
APP_KEY=ak_live_7e8b92c4a3f1d5e6b0c9a8f7e6d5c4b3

# The public URL, with scheme and no trailing slash. Used to build page
# permalinks in the admin panel.
APP_URL=https://yayasanspd.org

LOG_LEVEL=warning

# Point at a managed database instance, or at a db service you add to the
# compose file. Do not reuse the development password.
DB_HOST=https://yayasanspd.org/
DB_PORT=3306
DB_DATABASE=yayas195_krakatau
DB_USERNAME=yayas195_anak_krakatau
DB_PASSWORD=L4mpun6Dj4y4

# The existing schema is prefixed. Leave as-is unless you know otherwise.
DB_PREFIX=terre217_
