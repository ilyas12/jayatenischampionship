# Template for the production environment file.
#
#   cp .env.prod.example .env.prod
#
# Then fill it in. .env.prod is gitignored — keep it that way, and prefer your
# platform's secret store over a file on disk where you have one.
#
# Every value below is a placeholder. Never commit a real credential to this
# file: it is tracked, so anything written here is published to everyone with
# the repository and stays in its history.
#
# Used as:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# Tag applied to the built image, e.g. a release number or git SHA.
APP_VERSION=latest

# Published on 127.0.0.1 only — put a TLS-terminating reverse proxy in front.
APP_PORT=8080

APP_ENV=production

# Never true in production: debug pages print the stack trace along with the
# environment, credentials included.
APP_DEBUG=false

# MUST be unique to this deployment. Generate one with:
#   docker run --rm cms-template-engine:latest php artisan key:generate --show
# Changing it later invalidates all sessions and any encrypted data.
APP_KEY=

# The public URL, with scheme and no trailing slash. A trailing slash gives
# you // wherever code concatenates onto config('app.url'). Used to build page
# permalinks in the admin panel, and by the filemanager to resolve its own
# base URL.
APP_URL=https://example.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# Point at a managed database instance, or at a db service you add to the
# compose file. Do not reuse the development password.
#
# DB_HOST is a hostname or IP — not a URL. A scheme here fails at DNS with
# "php_network_getaddresses: getaddrinfo for https failed".
DB_HOST=db.example.com
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# The existing schema is prefixed. Leave as-is unless you know otherwise.
DB_PREFIX=terre217_

# config/mail.php reads MAIL_DRIVER; MAIL_MAILER is the name later Laravel
# versions use. Keep both in step so the mailer survives either config.
MAIL_MAILER=smtp
MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# The address registration payment instructions are sent from. It must be a
# mailbox the SMTP account above is allowed to send as, or the provider will
# rewrite or reject it.
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Jaya Tennis Championship"
