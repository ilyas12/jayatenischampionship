[mysqld]
# The dump is MyISAM/utf8mb3 and declares columns as
# `timestamp NOT NULL DEFAULT '0000-00-00 00:00:00'`. A strict sql_mode rejects
# those zero dates on both import and insert, so relax it to match the
# original cPanel host.
sql_mode = NO_ENGINE_SUBSTITUTION

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

max_allowed_packet = 128M

[client]
default-character-set = utf8mb4
