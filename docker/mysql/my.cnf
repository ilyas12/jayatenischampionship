[mysqld]
# The dump still needs a relaxed mode to IMPORT — it declares columns as
# `timestamp NOT NULL DEFAULT '0000-00-00 00:00:00'`, which NO_ZERO_DATE
# rejects. 03-zero-dates.sql clears those immediately afterwards, and the
# application's own connection asks for strict mode via 'strict' => true in
# config/database.php, so day-to-day queries are strict regardless of this.
sql_mode = NO_ENGINE_SUBSTITUTION

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

max_allowed_packet = 128M

[client]
default-character-set = utf8mb4
